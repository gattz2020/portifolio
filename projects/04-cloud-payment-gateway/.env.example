# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - CLOUDPAY GATEWAY ENGINE
# ==============================================================================

# Ambiente de Execução (development, staging, production)
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Banco de Dados Cloud (PostgreSQL / Supabase / Neon / RDS)
# Para desenvolvimento local sem PostgreSQL instalado, utiliza SQLite automaticamente:
DATABASE_URL=sqlite:///./cloudpay.db
# Exemplo para PostgreSQL em produção / Supabase:
# DATABASE_URL=postgresql://postgres:senha@db.supabase.co:5432/postgres

# Chave Criptográfica Secreta para Assinatura de Webhooks (HMAC-SHA256)
WEBHOOK_SECRET=cloudpay_super_secret_webhook_key_2026

# Gateway Mock / Credenciais Sandbox (Mercado Pago / Asaas / Stripe)
GATEWAY_API_KEY=mock_sandbox_key_abcdef123456
PIX_CHAVE=financeiro@minhaempresa.com.br
PIX_BENEFICIARIO=CloudPay Soluções Digitais
PIX_CIDADE=Goiania
